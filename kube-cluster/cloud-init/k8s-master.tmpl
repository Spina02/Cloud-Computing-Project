#cloud-config
hostname: __HOSTNAME__
users:
  - name: user01
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - __SSH_PUBKEY__

package_update: true
packages:
  - openssh-server
  - dnsmasq
  - iptables-persistent
  - containerd


write_files:
  # --- DHCP + DNS of the internal network (same options as the VirtualBox master) ---
  - path: /etc/dnsmasq.d/cluster.conf
    permissions: "0644"
    content: |
      bogus-priv
      resolv-file=/etc/resolv.dnsmasq
      listen-address=127.0.0.1,192.168.56.1
      bind-dynamic
      dhcp-range=192.168.56.2,192.168.56.10,infinite
      dhcp-option=option:router,192.168.56.1
      dhcp-option=option:dns-server,192.168.56.1
      cache-size=1000
      log-queries
      domain=cluster.local
      expand-hosts
      local=/cluster.local/
      # Do not publish /etc/hosts (127.0.1.1 master would leak to the workers);
      # the master is published explicitly with its internal address instead.
      no-hosts
      host-record=k8s-master,k8s-master.cluster.local,192.168.56.1

  # --- kernel parameters required by Kubernetes ---
  - path: /etc/sysctl.d/99-k8s.conf
    permissions: "0644"
    content: |
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward = 1

  - path: /etc/apt/apt.conf.d/99-k8s-network
    permissions: "0644"
    content: |
      Acquire::ForceIPv4 "true";
      Acquire::Retries "5";
  
  # --- containerd config file ---
  - path: /etc/modules-load.d/containerd.conf
    content: |
      overlay
      br_netfilter

  # --- force cubelet to use the right network ---
  - path: /etc/default/kubelet
    content: |
      KUBELET_EXTRA_ARGS=--node-ip=192.168.56.1

runcmd:
  # Enables IP forwarding
  - modprobe overlay
  - modprobe br_netfilter
  - sysctl --system
  # Configure iptables rules for NAT and forwarding between networks
  - iptables -t nat -A POSTROUTING -o enp1s0 -j MASQUERADE
  - iptables -P FORWARD DROP
  - iptables -A FORWARD -i enp2s0 -o enp1s0 -j ACCEPT
  - iptables -A FORWARD -i enp1s0 -o enp2s0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  - netfilter-persistent save
  # Link dnsmasq to systemd resolver for DNS
  - ln -sf /run/systemd/resolve/resolv.conf /etc/resolv.dnsmasq
  - systemctl enable dnsmasq
  - systemctl restart dnsmasq
  # Set local DNS via resolv.conf
  - rm -f /etc/resolv.conf
  - echo "nameserver 127.0.0.1" > /etc/resolv.conf
  - echo "options edns0 trust-ad" >> /etc/resolv.conf
  - echo "search cluster.local" >> /etc/resolv.conf
  # kubernetes cluster commands
  - mkdir -p /etc/apt/keyrings
  - curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.36/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
  - echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.36/deb/ /" > /etc/apt/sources.list.d/kubernetes.list
  - apt-get update
  - apt-get install -y kubelet kubeadm
  - apt-mark hold kubelet kubeadm
  - systemctl enable kubelet
  # force containerd to use cgroup instead of cgroup v2 
  - mkdir -p /etc/containerd
  - containerd config default > /etc/containerd/config.toml
  - sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
  - systemctl enable containerd
  - systemctl restart containerd
  # check that everything is ok
  - kubeadm version -o short && kubelet --version && grep -q 'SystemdCgroup = true' /etc/containerd/config.toml