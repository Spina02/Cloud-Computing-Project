#cloud-config
hostname: __HOSTNAME__
ssh_pwauth: true
chpasswd:
  expire: false
users:
  - name: user01
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    plain_text_passwd: pass
    ssh_authorized_keys:
      - __SSH_PUBKEY__
      
package_update: true
packages:
  - openssh-server
  - containerd

write_files:
  # --- kernel parameters required by Kubernetes ---
  - path: /etc/sysctl.d/99-k8s.conf
    permissions: "0644"
    content: |
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward = 1

  - path: /etc/apt/apt.conf.d/99-k8s-network
    permissions: "0644"
    content: |
      Acquire::ForceIPv4 "true";
      Acquire::Retries "5";

  # --- containerd config file ---
  - path: /etc/modules-load.d/containerd.conf
    content: |
      overlay
      br_netfilter

runcmd:
    # Enables IP forwarding
  - modprobe overlay
  - modprobe br_netfilter
  - sysctl --system
  # kubernetes cluster commands
  - mkdir -p /etc/apt/keyrings
  - curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.36/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
  - echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.36/deb/ /" > /etc/apt/sources.list.d/kubernetes.list
  - apt-get update
  - apt-get install -y kubelet kubeadm
  - apt-mark hold kubelet kubeadm
  - systemctl enable kubelet
  # force containerd to use cgroup instead of cgroup v2 
  - mkdir -p /etc/containerd
  - containerd config default > /etc/containerd/config.toml
  - sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
  - systemctl enable containerd
  - systemctl restart containerd
  # check that everything is ok
  - kubeadm version -o short && kubelet --version && grep -q 'SystemdCgroup = true' /etc/containerd/config.toml